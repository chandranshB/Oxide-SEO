---
import '../styles/global.css';

const resolvePath = (path) => {
  const base = import.meta.env.BASE_URL;
  const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `${cleanBase}${cleanPath}`;
};

let githubAssets = [];
try {
  const res = await fetch('https://api.github.com/repos/chandranshB/Oxide-SEO/releases/latest');
  if (res.ok) {
    const data = await res.json();
    githubAssets = data.assets || [];
  }
} catch (e) {
  console.error('Failed to fetch github releases at build time', e);
}
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Oxide-SEO - Technical SEO Simplified</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined') {
          const starlight = localStorage.getItem('starlight-theme');
          if (starlight === 'light' || starlight === 'dark') return starlight;
          if (starlight === 'auto') return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          const local = localStorage.getItem('theme');
          if (local) return local;
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      window.localStorage.setItem('theme', theme);
      window.localStorage.setItem('starlight-theme', theme);
    </script>
  </head>
  <body class="bg-[#f2f2f2] dark:bg-[#020202] text-zinc-900 dark:text-zinc-300 min-h-screen font-sans selection:bg-black selection:text-white dark:selection:bg-white dark:selection:text-black transition-colors duration-300">
    
    <!-- Top Navigation (App-like Header) -->
    <nav id="top-navbar" class="w-full flex justify-between items-center px-6 py-4 fixed top-0 left-0 right-0 z-[100] transition-all duration-300 transform translate-y-0 bg-transparent border-b border-transparent">
      <div class="text-[10px] tracking-widest text-zinc-500 dark:text-zinc-500 uppercase font-bold">
        OXIDE SEO BY SHAN
      </div>
      <div class="absolute left-1/2 -translate-x-1/2 font-press-start text-[10px] tracking-tight flex items-center gap-2">
        <span><span class="text-green-500">Ox</span><span class="text-black dark:text-white">ide</span> SEO</span>
      </div>
      <div class="flex gap-4 md:gap-6 items-center text-xs font-medium tracking-wide">
        <button id="theme-toggle" class="relative p-2 w-9 h-9 flex items-center justify-center text-zinc-500 hover:text-black dark:text-zinc-400 dark:hover:text-white transition-colors overflow-hidden rounded-full focus:outline-none">
          <svg class="absolute inset-0 m-auto w-5 h-5 transition-all duration-500 transform dark:rotate-90 dark:opacity-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2"/>
            <path d="M12 20v2"/>
            <path d="m4.93 4.93 1.41 1.41"/>
            <path d="m17.66 17.66 1.41 1.41"/>
            <path d="M2 12h2"/>
            <path d="M20 12h2"/>
            <path d="m6.34 17.66-1.41 1.41"/>
            <path d="m19.07 4.93-1.41 1.41"/>
          </svg>
          <svg class="absolute inset-0 m-auto w-5 h-5 transition-all duration-500 transform -rotate-90 opacity-0 dark:rotate-0 dark:opacity-100" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>
        <a href={resolvePath('/guides/introduction')} class="hidden md:block text-zinc-500 hover:text-black dark:text-zinc-400 dark:hover:text-white transition-colors">Documentation</a>
        <a href="https://github.com/chandranshB/Oxide-SEO" class="hidden md:block text-zinc-500 hover:text-black dark:text-zinc-400 dark:hover:text-white transition-colors">GitHub</a>
      </div>
    </nav>

    <!-- Hero Section -->
    <main class="w-full relative flex flex-col items-center overflow-hidden px-4 md:px-8">
      
      <!-- Animated dynamic gradient blobs (from OnboardingWizard) -->
      <style>
        @keyframes blob-1 {
          0% { transform: translate(0px, 0px) scale(1) rotate(0deg); }
          20% { transform: translate(300px, -200px) scale(1.4) rotate(90deg); }
          40% { transform: translate(-400px, 300px) scale(0.6) rotate(180deg); }
          60% { transform: translate(500px, 400px) scale(1.2) rotate(270deg); }
          80% { transform: translate(-300px, -400px) scale(0.8) rotate(360deg); }
          100% { transform: translate(0px, 0px) scale(1) rotate(450deg); }
        }
        @keyframes blob-2 {
          0% { transform: translate(0px, 0px) scale(1) rotate(0deg); }
          25% { transform: translate(-500px, -300px) scale(0.7) rotate(-90deg); }
          50% { transform: translate(400px, -400px) scale(1.5) rotate(-180deg); }
          75% { transform: translate(-300px, 500px) scale(0.9) rotate(-270deg); }
          100% { transform: translate(0px, 0px) scale(1) rotate(-360deg); }
        }
        @keyframes blob-3 {
          0% { transform: translate(0px, 0px) scale(1); }
          20% { transform: translate(400px, 500px) scale(1.3); }
          40% { transform: translate(-200px, -500px) scale(0.7); }
          60% { transform: translate(-500px, 200px) scale(1.4); }
          80% { transform: translate(300px, -300px) scale(0.8); }
          100% { transform: translate(0px, 0px) scale(1); }
        }
        @keyframes blob-4 {
          0% { transform: translate(0px, 0px) scale(1); }
          33% { transform: translate(-400px, 200px) scale(1.5); }
          66% { transform: translate(500px, -200px) scale(0.5); }
          100% { transform: translate(0px, 0px) scale(1); }
        }
        .animate-blob-1 { animation: blob-1 8s infinite ease-in-out; }
        .animate-blob-2 { animation: blob-2 11s infinite ease-in-out; }
        .animate-blob-3 { animation: blob-3 9s infinite ease-in-out; }
        .animate-blob-4 { animation: blob-4 13s infinite ease-in-out; }
      </style>

      <div id="hover-blobs" class="fixed inset-0 transition-opacity ease-in-out pointer-events-none z-0 opacity-0 duration-700">
         <div id="blob-1" class="absolute top-1/4 left-1/4 w-[600px] h-[600px] bg-blue-500/30 rounded-full mix-blend-screen filter blur-[150px] animate-blob-1 transition-colors duration-500"></div>
         <div id="blob-2" class="absolute top-1/3 right-1/4 w-[500px] h-[500px] bg-cyan-500/30 rounded-full mix-blend-screen filter blur-[150px] animate-blob-2 transition-colors duration-500"></div>
         <div id="blob-3" class="absolute bottom-1/4 left-1/3 w-[700px] h-[700px] bg-sky-500/30 rounded-full mix-blend-screen filter blur-[150px] animate-blob-3 transition-colors duration-500"></div>
         <div id="blob-4" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-indigo-500/30 rounded-full mix-blend-screen filter blur-[150px] animate-blob-4 transition-colors duration-500"></div>
      </div>

      <div class="w-full min-h-[85vh] flex flex-col justify-center items-center relative z-10 pt-20">
        <div class="max-w-4xl w-full text-center space-y-10">
          
          <h1 class="text-3xl md:text-5xl font-press-start text-black dark:text-white leading-[1.4] tracking-tight">
            Pro SEO.<br />
            Zero Subscriptions.
          </h1>
          
          <p class="text-base md:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed mt-4">
            Oxide-SEO is the ultimate local engine for the data-obsessed. Connect directly to Google, crawl thousands of pages instantly, and uncover competitor secrets. No cloud. No limits. Just raw, unadulterated ranking power.
          </p>

          <div class="flex flex-col items-center justify-center pt-8">
            <div class="relative inline-flex items-center group z-20 shadow-xl rounded-xl bg-black/5 dark:bg-white/5 backdrop-blur-md border border-black/10 dark:border-white/10 transition-all hover:bg-black/10 dark:hover:bg-white/10 hover:border-black/20 dark:hover:border-white/20 hover:shadow-2xl" id="dl-button-group">
               
               <button id="main-dl-btn" class="px-6 py-3 text-zinc-800 dark:text-zinc-200 font-medium hover:text-black dark:hover:text-white flex items-center gap-3 text-base transition-colors relative overflow-hidden">
                 <span class="relative z-10" id="dl-btn-text">Download for Windows</span>
                 <svg class="relative z-10 w-4 h-4 text-zinc-500 group-hover:text-black dark:group-hover:text-white group-hover:translate-y-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
               </button>
               
               <div class="w-px h-6 bg-black/10 dark:bg-white/10 group-hover:bg-black/20 dark:group-hover:bg-white/20 transition-colors"></div>
               
               <button id="dl-dropdown-trigger" class="px-3 py-3 text-zinc-500 dark:text-zinc-400 hover:text-black dark:hover:text-white transition-colors h-full flex items-center justify-center focus:outline-none">
                 <svg class="w-4 h-4 transition-transform" id="dl-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
               </button>
               
               <!-- Dropdown Menu -->
               <div id="dl-dropdown-menu" class="absolute top-full right-0 mt-2 w-48 bg-white dark:bg-[#0a0a0a] border border-zinc-200 dark:border-zinc-800 rounded-xl shadow-2xl overflow-hidden opacity-0 pointer-events-none transition-all transform origin-top scale-95 flex flex-col z-50">
                  <button data-os="win" class="w-full text-left px-4 py-3 text-sm text-zinc-600 dark:text-zinc-300 hover:bg-black/5 dark:hover:bg-white/10 hover:text-black dark:hover:text-white transition-colors">
                    Windows
                  </button>
                  <button data-os="mac" class="w-full text-left px-4 py-3 text-sm text-zinc-600 dark:text-zinc-300 hover:bg-black/5 dark:hover:bg-white/10 hover:text-black dark:hover:text-white transition-colors">
                    macOS
                  </button>
                  <button data-os="linux" class="w-full text-left px-4 py-3 text-sm text-zinc-600 dark:text-zinc-300 hover:bg-black/5 dark:hover:bg-white/10 hover:text-black dark:hover:text-white transition-colors">
                    Linux
                  </button>
               </div>
            </div>
            
            <a href="https://github.com/chandranshB/Oxide-SEO/releases/latest" id="dl-fallback-link" class="mt-4 text-xs font-medium text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors opacity-0 pointer-events-none">
              View all releases on GitHub ->
            </a>
          </div>
        </div>
      </div>

      <!-- Asset Selection Modal -->
      <div id="dl-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
         <div class="bg-[#0a0a0a] border border-zinc-800 rounded-2xl w-full max-w-md p-6 transform scale-95 transition-transform duration-300 flex flex-col shadow-2xl" id="dl-modal-content">
            <div class="flex justify-between items-center mb-6">
               <h3 class="font-press-start text-[10px] text-green-500 tracking-widest uppercase">Select Version</h3>
               <button id="dl-modal-close" class="text-zinc-500 hover:text-white transition-colors p-1">
                 <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
               </button>
            </div>
            <p class="text-sm text-zinc-400 mb-6 leading-relaxed">Multiple installation formats are available for your platform. Please select one to download.</p>
            <div id="dl-modal-options" class="flex flex-col gap-3">
               <!-- Injected via JS -->
            </div>
         </div>
      </div>

      <script define:vars={{ githubAssets }}>
        const mainBtn = document.getElementById('main-dl-btn');
        const btnText = document.getElementById('dl-btn-text');
        const trigger = document.getElementById('dl-dropdown-trigger');
        const menu = document.getElementById('dl-dropdown-menu');
        const chevron = document.getElementById('dl-chevron');
        const btnGroup = document.getElementById('dl-button-group');
        const fallback = document.getElementById('dl-fallback-link');
        
        const modal = document.getElementById('dl-modal');
        const modalContent = document.getElementById('dl-modal-content');
        const modalClose = document.getElementById('dl-modal-close');
        const modalOptions = document.getElementById('dl-modal-options');
        
        const blobs = document.getElementById('hover-blobs');
        const b1 = document.getElementById('blob-1');
        const b2 = document.getElementById('blob-2');
        const b3 = document.getElementById('blob-3');
        const b4 = document.getElementById('blob-4');

        let currentOS = 'win';
        let menuOpen = false;

        const detectOS = () => {
          const ua = window.navigator.userAgent.toLowerCase();
          if (ua.includes('mac')) return 'mac';
          if (ua.includes('linux')) return 'linux';
          return 'win';
        };

        const osNames = { win: 'Windows', mac: 'macOS', linux: 'Linux' };

        const updateOS = (os) => {
          currentOS = os;
          btnText.textContent = `Download for ${osNames[os]}`;
        };

        const getAssetsForOS = (os) => {
          if (!githubAssets || !githubAssets.length) return [];
          return githubAssets.filter(asset => {
            const name = asset.name.toLowerCase();
            if (os === 'win') return name.endsWith('.exe') || name.endsWith('.msi');
            if (os === 'mac') return name.endsWith('.dmg') || name.includes('mac') || name.endsWith('.app.tar.gz');
            if (os === 'linux') return name.endsWith('.appimage') || name.endsWith('.deb') || name.endsWith('.rpm');
            return false;
          });
        };

        const formatBytes = (bytes) => {
          if (bytes === 0) return '0 Bytes';
          const k = 1024, sizes = ['Bytes', 'KB', 'MB', 'GB'];
          const i = Math.floor(Math.log(bytes) / Math.log(k));
          return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
        };

        const handleDownload = () => {
          const assets = getAssetsForOS(currentOS);
          if (assets.length === 0) {
             window.open('https://github.com/chandranshB/Oxide-SEO/releases/latest', '_blank');
             return;
          }
          if (assets.length === 1) {
            window.location.href = assets[0].browser_download_url;
          } else {
            const formatAssetName = (name) => {
              const n = name.toLowerCase();
              if (n.endsWith('.exe')) return 'Windows Setup (.exe)';
              if (n.endsWith('.msi')) return 'Windows Installer (.msi)';
              if (n.endsWith('.dmg')) {
                if (n.includes('aarch64') || n.includes('arm64')) return 'Apple Silicon (.dmg)';
                if (n.includes('x64') || n.includes('intel')) return 'Intel Mac (.dmg)';
                return 'macOS Installer (.dmg)';
              }
              if (n.endsWith('.appimage')) return 'Linux Portable (.AppImage)';
              if (n.endsWith('.deb')) return 'Debian / Ubuntu (.deb)';
              if (n.endsWith('.rpm')) return 'Fedora / Red Hat (.rpm)';
              if (n.endsWith('.tar.gz')) return 'Linux Archive (.tar.gz)';
              return name;
            };

            modalOptions.innerHTML = '';
            assets.forEach(asset => {
              const btn = document.createElement('button');
              btn.className = 'w-full flex items-center justify-between p-4 rounded-xl border border-white/5 bg-white/5 hover:bg-white/10 transition-colors text-left group';
              
              const sizeMB = (asset.size / (1024 * 1024)).toFixed(1);
              const cleanName = formatAssetName(asset.name);
              
              btn.innerHTML = `
                <div class="flex flex-col">
                  <span class="text-white font-medium group-hover:text-green-400 transition-colors">${cleanName}</span>
                  <span class="text-xs text-zinc-500 mt-1 font-mono">${asset.name} &bull; ${sizeMB} MB</span>
                </div>
                <svg class="w-5 h-5 text-zinc-500 group-hover:text-green-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              `;
              btn.onclick = () => {
                window.location.href = asset.browser_download_url;
                closeModal();
              };
              modalOptions.appendChild(btn);
            });
            openModal();
          }
        };

        const openModal = () => {
          modal.classList.remove('opacity-0', 'pointer-events-none');
          modalContent.classList.remove('scale-95');
          modalContent.classList.add('scale-100');
        };
        const closeModal = () => {
          modal.classList.add('opacity-0', 'pointer-events-none');
          modalContent.classList.remove('scale-100');
          modalContent.classList.add('scale-95');
        };

        modalClose.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

        const toggleMenu = () => {
          menuOpen = !menuOpen;
          if (menuOpen) {
            menu.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
            menu.classList.add('scale-100');
            chevron.classList.add('rotate-180');
          } else {
            menu.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
            menu.classList.remove('scale-100');
            chevron.classList.remove('rotate-180');
          }
        };

        trigger.addEventListener('click', (e) => { e.stopPropagation(); toggleMenu(); });
        document.querySelectorAll('#dl-dropdown-menu button').forEach(btn => {
          btn.addEventListener('click', (e) => {
            updateOS(e.currentTarget.dataset.os);
            toggleMenu();
          });
        });
        document.addEventListener('click', () => { if (menuOpen) toggleMenu(); });
        mainBtn.addEventListener('click', handleDownload);

        const setColors = (theme) => {
          [b1, b2, b3, b4].forEach(b => b.className = b.className.replace(/bg-\w+-\d+\/\d+/g, '').trim());
          if (theme === 'win') {
            b1.classList.add('bg-blue-500/30'); b2.classList.add('bg-cyan-500/30'); b3.classList.add('bg-sky-500/30'); b4.classList.add('bg-indigo-500/30');
          } else if (theme === 'mac') {
            b1.classList.add('bg-purple-500/30'); b2.classList.add('bg-pink-500/30'); b3.classList.add('bg-orange-500/30'); b4.classList.add('bg-rose-500/30');
          } else {
            b1.classList.add('bg-green-500/30'); b2.classList.add('bg-emerald-500/30'); b3.classList.add('bg-cyan-500/30'); b4.classList.add('bg-indigo-500/20');
          }
        };

        if (btnGroup && blobs) {
          btnGroup.addEventListener('mouseenter', () => {
            setColors(currentOS);
            blobs.classList.remove('opacity-0');
            blobs.classList.add('opacity-100');
          });
          btnGroup.addEventListener('mouseleave', () => {
            blobs.classList.remove('opacity-100');
            blobs.classList.add('opacity-0');
          });
        }

        updateOS(detectOS());
        const themeToggleBtn = document.getElementById('theme-toggle');
        themeToggleBtn.addEventListener('click', function() {
            const isDark = document.documentElement.classList.contains('dark');
            const newTheme = isDark ? 'light' : 'dark';
            
            if (newTheme === 'dark') {
                document.documentElement.classList.add('dark');
                document.documentElement.setAttribute('data-theme', 'dark');
            } else {
                document.documentElement.classList.remove('dark');
                document.documentElement.setAttribute('data-theme', 'light');
            }
            
            localStorage.setItem('theme', newTheme);
            localStorage.setItem('starlight-theme', newTheme);
        });

        // Navbar scroll logic
        const navbar = document.getElementById('top-navbar');
        let lastScrollY = window.scrollY;
        
        window.addEventListener('scroll', () => {
          const currentScrollY = window.scrollY;
          
          if (currentScrollY > 50) {
            navbar.classList.add('bg-white/80', 'dark:bg-[#020202]/80', 'backdrop-blur-md', 'border-black/10', 'dark:border-white/10');
            navbar.classList.remove('bg-transparent', 'border-transparent');
          } else {
            navbar.classList.remove('bg-white/80', 'dark:bg-[#020202]/80', 'backdrop-blur-md', 'border-black/10', 'dark:border-white/10');
            navbar.classList.add('bg-transparent', 'border-transparent');
          }
          
          if (currentScrollY > lastScrollY && currentScrollY > 100) {
            // Scrolling down - hide navbar
            navbar.classList.add('-translate-y-full');
          } else {
            // Scrolling up - show navbar
            navbar.classList.remove('-translate-y-full');
          }
          
          lastScrollY = currentScrollY;
        }, { passive: true });
        if (!githubAssets || githubAssets.length === 0) {
          fallback.classList.remove('opacity-0', 'pointer-events-none');
        }
      </script>
      <div class="hidden bg-blue-500/30 bg-cyan-500/30 bg-sky-500/30 bg-indigo-500/30 bg-purple-500/30 bg-pink-500/30 bg-orange-500/30 bg-rose-500/30 bg-green-500/30 bg-emerald-500/30 bg-indigo-500/20"></div>

      <!-- Features Hyper-Brutalist Layout -->
      <div class="w-full max-w-6xl mx-auto mt-20 relative pb-32 space-y-24 z-10 px-4">
        
        <!-- Feature 1 -->
        <div class="sticky top-[10vh] p-8 md:p-16 bg-white dark:bg-[#050505] border-4 border-black dark:border-white/20 shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] dark:shadow-[0_0_80px_rgba(255,255,255,0.05)] flex flex-col md:flex-row gap-12 items-center relative overflow-hidden transition-all">
          <div class="absolute inset-0 bg-gradient-to-br from-green-400/10 to-transparent pointer-events-none"></div>
          <div class="flex-1 relative z-10">
            <div class="inline-block bg-black text-white dark:bg-white dark:text-black font-press-start text-[10px] tracking-widest px-4 py-2 mb-8 uppercase">01. GSC DATA</div>
            <h3 class="text-5xl md:text-7xl font-black text-black dark:text-white mb-8 tracking-tighter leading-[1.1] uppercase">The Data They Wanted To Hide.</h3>
            <p class="text-xl md:text-2xl text-zinc-600 dark:text-zinc-400 leading-snug font-medium max-w-xl">
              Google intentionally caps your Search Console data at <span class="text-black dark:text-white font-bold bg-green-400/20 px-1">16 months</span>. Oxide breaks the locks and siphons your complete historical dataset directly to your local drive.
            </p>
          </div>
          <div class="w-full md:w-1/3 relative z-10 space-y-4 text-base font-bold text-black dark:text-white">
            <div class="p-6 bg-zinc-100 dark:bg-white/5 border-2 border-black dark:border-white/10 flex items-center gap-4"><span class="text-green-500 font-press-start">></span> Evades API blackout</div>
            <div class="p-6 bg-zinc-100 dark:bg-white/5 border-2 border-black dark:border-white/10 flex items-center gap-4"><span class="text-green-500 font-press-start">></span> Stealth background sync</div>
            <div class="p-6 bg-zinc-100 dark:bg-white/5 border-2 border-black dark:border-white/10 flex items-center gap-4"><span class="text-green-500 font-press-start">></span> Zero surveillance</div>
          </div>
