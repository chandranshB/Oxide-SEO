---
import type { Props } from '@astrojs/starlight/props';

const base = import.meta.env.BASE_URL;
const homeUrl = base.endsWith('/') ? base : `${base}/`;
---

<a href={homeUrl} class="site-title font-press-start text-xl md:text-2xl no-underline inline-block">
  <span class="text-green-600 dark:text-green-500">Ox</span>ide-SEO
</a>

<style>
  .site-title, .site-title:hover {
    color: var(--color-wiki-text) !important;
    text-decoration: none;
  }
</style>
